{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LayerCake - Make Run (default_name)",
            "type": "shell",
            "command": "wsl",
            "args": ["make", "run", "PROG_NAME=default_name"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "LayerCake - Make Build (default_name)",
            "type": "shell",
