{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FastAsmWslComp - Build and Run",
            "type": "shell",
            "command": "wsl",
            "args": ["make", "run", "PROG_NAME=program"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "FastAsmWslComp - Build Only",
            "type": "shell",
            "command": "wsl",
            "args": ["make", "build", "PROG_NAME=program"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "FastAsmWslComp - Debug with GDB",
            "type": "shell",
            "command": "wsl",
            "args": ["make", "run_debug", "PROG_NAME=program"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "FastAsmWslComp - Clean Build",
            "type": "shell",
            "command": "wsl",
            "args": ["make", "clean"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "FastAsmWslComp - Show Help",
            "type": "shell",
            "command": "wsl",
            "args": ["make", "help"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
